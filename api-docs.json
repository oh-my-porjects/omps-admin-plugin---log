            "name": "items",
            "type": "array",
            "description": "审计日志列表。",
            "fields": [
              {
                "name": "id",
                "type": "integer",
                "description": "审计日志自增 ID。"
              },
              {
                "name": "actor",
                "type": "string",
                "description": "操作人标识。"
              },
              {
                "name": "action",
                "type": "string",
                "description": "动作编码。"
              },
              {
                "name": "module",
                "type": "string",
                "description": "模块名称。"
              },
              {
                "name": "before",
                "type": "object",
                "description": "操作前状态。",
                "fields": []
              },
              {
                "name": "after",
                "type": "object",
                "description": "操作后状态。",
                "fields": []
              },
              {
                "name": "extra",
                "type": "object",
                "description": "额外上下文。",
                "fields": []
              },
              {
                "name": "created_at",
                "type": "string",
                "description": "创建时间，数据库返回的时间字符串。"
              }
            ]
          }
        ],
        "error_codes": [
          {
            "status": -1,
            "msg": "统计失败或查询失败。"
          }
        ]
      },
      "response_example": {
        "status": 0,
        "data": {
          "total": 1,
          "items": [
            {
              "id": 1,
              "actor": "admin_root",
              "action": "wallet.approve",
              "module": "wallet",
