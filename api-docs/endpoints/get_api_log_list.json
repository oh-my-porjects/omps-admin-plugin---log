{
  "method": "GET",
  "path": "/api/log/list",
  "endpoint_key": "GET /api/log/list",
  "title": "查询审计日志",
  "description": "分页查询审计日志，可按操作人、动作、模块和创建时间范围过滤。",
  "auth": "admin_session",
  "params": [
    {
      "name": "actor",
      "type": "string",
      "required": false,
      "description": "按操作人过滤。"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "按动作编码过滤。"
    },
    {
      "name": "module",
      "type": "string",
      "required": false,
      "description": "按模块名称过滤。"
    },
    {
      "name": "since",
      "type": "string",
      "required": false,
      "description": "开始时间，数据库可解析的时间字符串。"
    },
    {
      "name": "until",
      "type": "string",
      "required": false,
      "description": "结束时间，数据库可解析的时间字符串。"
    },
    {
      "name": "page",
      "type": "integer",
      "required": false,
      "constraint": "默认 1，大于等于 1",
      "description": "页码。"
    },
    {
      "name": "page_size",
      "type": "integer",
      "required": false,
      "constraint": "默认 50，最大 200",
      "description": "每页数量。"
    }
  ],
  "response": {
    "description": "返回审计日志分页结果。",
    "data_type": "object",
    "fields": [
      {
        "name": "total",
        "type": "integer",
        "description": "总数量。"
      },
      {
        "name": "items",
        "type": "array",
        "description": "审计日志列表。",
        "fields": [
          {
            "name": "id",
            "type": "integer",
            "description": "审计日志自增 ID。"
          },
          {
            "name": "actor",
            "type": "string",
            "description": "操作人标识。"
          },
          {
            "name": "action",
            "type": "string",
            "description": "动作编码。"
          },
          {
            "name": "module",
            "type": "string",
            "description": "模块名称。"
          },
          {
            "name": "before",
            "type": "object",
            "description": "操作前状态。",
            "fields": []
          },
          {
            "name": "after",
            "type": "object",
            "description": "操作后状态。",
            "fields": []
          },
          {
            "name": "extra",
            "type": "object",
            "description": "额外上下文。",
            "fields": []
          },
          {
            "name": "created_at",
            "type": "string",
            "description": "创建时间，数据库返回的时间字符串。"
          }
        ]
      }
    ],
    "error_codes": [
      {
        "status": -1,
        "msg": "统计失败或查询失败。"
      }
    ]
  },
  "response_example": {
    "status": 0,
    "data": {
      "total": 1,
      "items": [
        {
          "id": 1,
          "actor": "admin_root",
          "action": "wallet.approve",
          "module": "wallet",
          "before": {
            "status": 1
          },
          "after": {
            "status": 2
          },
          "extra": {},
          "created_at": "2026-05-28T00:00:00Z"
        }
      ]
    },
    "msg": ""
  },
  "rules": [
    {
      "category": "security",
      "title": "查询审计日志 鉴权边界",
      "body": "该接口按 auth=admin_session 执行访问控制；未满足身份、内部令牌、后台会话或 API key 要求时必须拒绝主流程。接口职责：分页查询审计日志，可按操作人、动作、模块和创建时间范围过滤。",
      "code_loc": "main.go:154"
    }
  ]
}
